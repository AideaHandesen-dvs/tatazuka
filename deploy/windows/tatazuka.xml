<?xml version="1.0" encoding="UTF-8"?>
<!--
  佇か（tatazuka）Task Scheduler タスク テンプレート（Windows）。
  設置手順は deploy/README.md を参照。__REPO__ / __USER__ を実値に置換してから取り込む：

    # schtasks /XML は UTF-16 を要求する（UTF-8 だと "unable to switch the encoding"＝実機で確認）。
    # 置換と同時に prolog を UTF-16 へ書き換え、-Encoding Unicode（UTF-16 LE）で書き出す。
    $repo = "$env:USERPROFILE\tatazuka"
    (Get-Content "$repo\deploy\windows\tatazuka.xml" -Raw) `
      -replace '__REPO__', $repo -replace '__USER__', "$env:USERDOMAIN\$env:USERNAME" `
      -replace 'encoding="UTF-8"', 'encoding="UTF-16"' |
      Set-Content "$env:TEMP\tatazuka.xml" -Encoding Unicode
    schtasks /Create /TN tatazuka /XML "$env:TEMP\tatazuka.xml" /F

  ログオン時起動（systemd の enable + default.target / launchd RunAtLoad の対）。秘密は
  この XML でなく %USERPROFILE%\.config\tatazuka\tatazuka.env へ（ラッパー tatazuka-launch.ps1 が読む）。
-->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>佇か（tatazuka）desktop mascot server — HTTPS + WebSocket (protocol v0)</Description>
    <URI>\tatazuka</URI>
  </RegistrationInfo>

  <!-- 二段構え。LogonTrigger＝ログオン時に即起動（systemd default.target / launchd RunAtLoad の対）。
       TimeTrigger＝過去起点の 1 分ごと無限 repetition で、クラッシュ復活の主機構を担う：
       生存中は下の MultipleInstancesPolicy=IgnoreNew で無視され、死んでいれば 1 分以内に起こし直す
       ＝Task Scheduler の枯れた keep-alive 定石。InteractiveToken なのでログオン中だけ鳴る（ログアウト中は
       佇かも要らない）。
       ※ LogonTrigger に repetition を付けても効かない：repetition はログオンイベントに紐付くため、
         ログオン後に登録した同一 session では発火しない（実機 tiny10 で確認）。だから時刻起点の
         TimeTrigger を別に立てる。RestartOnFailure はプロセス異常終了で確実に発火しないので使わない（同上）。
         復活レイテンシは最大 1 分＝Windows は粒度が粗い。 -->
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
      <UserId>__USER__</UserId>
    </LogonTrigger>
    <TimeTrigger>
      <Enabled>true</Enabled>
      <StartBoundary>2020-01-01T00:00:00</StartBoundary>
      <Repetition>
        <Interval>PT1M</Interval>
        <StopAtDurationEnd>false</StopAtDurationEnd>
      </Repetition>
    </TimeTrigger>
  </Triggers>

  <!-- ユーザー権限だけで動かす（root/管理者不要＝systemd user サービス / LaunchAgent と同じ） -->
  <Principals>
    <Principal id="Author">
      <UserId>__USER__</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>

  <Settings>
    <!-- 二重起動しない（systemd の単一インスタンスに相当） -->
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <!-- 同居人はバッテリ駆動でも黙って戻ってくる。電源状態で止めない -->
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <!-- 天気/Home Assistant は network 不要でも PE で縮退する。network を必須にしない -->
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <!-- 裏で常駐（ProcessType Background / ProcessType=simple のサーバ相当） -->
    <Hidden>true</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <!-- 常駐サーバなので実行時間に上限を設けない（PT0S＝無制限） -->
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>7</Priority>
    <!-- クラッシュ復活は上の LogonTrigger の Repetition（1 分ごと＋IgnoreNew）で担う。
         RestartOnFailure はプロセス異常終了で確実に発火しなかったため使わない（実機 tiny10 で確認）。 -->
  </Settings>

  <Actions Context="Author">
    <!-- ラッパー経由で起動（env 読み込み・node 解決・ログ追記はラッパー側）。窓は出さない -->
    <Exec>
      <Command>powershell.exe</Command>
      <Arguments>-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File "__REPO__\deploy\windows\tatazuka-launch.ps1"</Arguments>
    </Exec>
  </Actions>
</Task>
