# 佇か env 雛形 — コピーして ~/.config/tatazuka/tatazuka.env に置く（systemd EnvironmentFile）。
#
#   mkdir -p ~/.config/tatazuka
#   cp deploy/systemd/tatazuka.env.example ~/.config/tatazuka/tatazuka.env
#   # 要るものだけコメントを外して埋める。全部空でもルールベースで起動する（PE）。
#   chmod 600 ~/.config/tatazuka/tatazuka.env   # 秘密を含むので自分だけ読める権限に
#
# 構文は systemd EnvironmentFile（KEY=VALUE・export 不要・値の空白は "..." で囲む）。
# 各 env の意味は server/README.md / connectors/README.md を参照。ここは抜粋。

# --- 基本 ---
# PORT=8443                       # 待受ポート（既定 8443）

# --- 人格（LLM 差し替え。未設定ならルールベース） ---
# TZ_LLM=ollama                   # ollama か claude
# TZ_LLM_MODEL=qwen2.5:3b         # モデル名（claude なら claude-haiku-4-5 が実用）
# TZ_CHARACTER=tatazuka           # ゴースト（characters/<名前>.txt）。同梱: tatazuka / shitsuji / imouto
# ANTHROPIC_API_KEY=sk-ant-...    # TZ_LLM=claude のとき（★秘密）

# --- 天気（イベント源・キー不要の Open-Meteo） ---
# TZ_CITY=Tokyo                   # 都市名。または TZ_LAT/TZ_LON で直接
# TZ_LAT=35.68
# TZ_LON=139.69

# --- Home Assistant（在宅/外出。三つ揃って有効） ---
# TZ_HASS_URL=http://homeassistant.local:8123
# TZ_HASS_TOKEN=eyJ...            # 長期アクセストークン（★秘密）
# TZ_HASS_PERSON=person.john

# --- soft 委譲の readonly プローブ（家の中が少し見える同居人・connectors/README §7-1） ---
# TZ_GIT_REPO=/home/john/tatazuka # 監視リポ（未コミット/未 push）
# TZ_DISK_PATH=/                  # 空き容量しきい値（TZ_DISK_MIN_PCT 既定 10）
# TZ_MEM=1                        # 空きメモリしきい値
# TZ_NET=1                        # オンライン/オフライン
# TZ_NIC=1                        # 通信レート busy/idle
# TZ_BATTERY=1                    # 残量 low/ok ＋満充電ケア
# TZ_TEMP=1                       # 温度 hot/ok（Linux のみ。Mac/Win は特権側で縮退）
# TZ_DOWNLOAD=1                   # ダウンロード完了（~/Downloads の差分）
# TZ_TRASH=1                      # ゴミ箱が溜まったら掃除ナッジ
# TZ_RESUME=1                     # スリープ復帰「おかえり」

# --- プレゼンス（デバッグ） ---
# TZ_BROADCAST=1                  # 全部屋に佇かが出る退化形（既定は一度に一箇所）
